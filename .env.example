# Copy to .env (never commit .env) and fill in real values.

# --- apps/ai (Nexa backend) ---
# Required when DALTRON_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Provider: "gemini" or "test" (test needs no API key)
DALTRON_AI_PROVIDER=gemini
# Must be a name registered in apps/ai/core/models/model-registry.ts
DALTRON_AI_MODEL=gemini-3.6-flash
DALTRON_AI_TEMPERATURE=0.7
DALTRON_AI_MAX_TOKENS=1000
PORT=4000
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- apps/web (set in apps/web/.env.local) ---
# VITE_NEXA_API_URL=http://localhost:4000

