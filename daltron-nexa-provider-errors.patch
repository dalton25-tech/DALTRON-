+import express from 'express';
+import type { ErrorRequestHandler, Express } from 'express';
+import cors from 'cors';
+import nexaRoutes from './routes/nexaRoutes.js';
+
+export interface AppOptions {
+  allowedOrigins?: string[];
+}
+
+function originsFromEnv(): string[] {
+  // Comma-separated list of allowed browser origins. Defaults to the Vite dev server.
+  return (process.env.CORS_ORIGIN ?? 'http://localhost:5173')
+    .split(',')
+    .map((origin) => origin.trim())
+    .filter(Boolean);
+}
+
+// Returns JSON (never an HTML stack trace) for malformed or oversized request bodies.
+// Express identifies error handlers by their four-argument signature.
+// eslint-disable-next-line @typescript-eslint/no-unused-vars
+const handleRequestErrors: ErrorRequestHandler = (error: unknown, _req, res, _next) => {
+  const status =
+    typeof error === 'object' &&
+    error !== null &&
+    'status' in error &&
+    typeof error.status === 'number'
+      ? error.status
+      : 500;
+
+  if (status === 413) {
+    return res.status(413).json({ error: 'Request body is too large.' });
+  }
+
+  if (status === 400) {
+    return res.status(400).json({ error: 'Invalid request body.' });
+  }
+
+  console.error('Unhandled request error:', error);
+
+  return res.status(500).json({ error: 'Internal server error.' });
+};
+
+export function createApp(options: AppOptions = {}): Express {
+  const app = express();
+
+  app.use(cors({ origin: options.allowedOrigins ?? originsFromEnv() }));
+  app.use(express.json({ limit: '16kb' }));
+
+  app.get('/health', (_req, res) => {
+    res.json({
+      status: 'online',
+      system: 'Nexa Backend',
+    });
+  });
+
+  app.use('/api/nexa', nexaRoutes);
+  app.use(handleRequestErrors);
+
+  return app;
+}
