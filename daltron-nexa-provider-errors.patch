@@ -0,0 +1,82 @@
+import assert from 'node:assert/strict';
+import { afterEach, beforeEach, mock, test } from 'node:test';
+import { AIProviderError } from '../core/errors.js';
+import { InferenceEngine } from '../core/inference/inference.js';
+import type { AIModel } from '../core/models/model.js';
+import { fakeProvider, fastConfig, upstreamError } from './helpers.js';
+import type { FakeProvider } from './helpers.js';
+
+beforeEach(() => {
+  // The inference engine logs on every call; keep test output readable.
+  mock.method(console, 'log', () => {});
+  mock.method(console, 'warn', () => {});
+});
+
+afterEach(() => {
+  mock.restoreAll();
+});
+
+function engineFor(provider: FakeProvider, overrides: Partial<typeof fastConfig> = {}) {
+  const model: AIModel = {
+    name: 'test-model',
+    provider,
+    capabilities: { streaming: false, tools: false },
+    contextWindow: 1000,
+  };
+
+  return new InferenceEngine(model, { ...fastConfig, ...overrides });
+}
+
+test('returns the provider output on success without retrying', async () => {
+  const provider = fakeProvider(async () => 'ok');
+
+  assert.equal(await engineFor(provider).generate('hi'), 'ok');
+  assert.equal(provider.calls, 1);
+});
+
+test('retries transient 503 errors and then succeeds', async () => {
+  const provider = fakeProvider(async (_options, call) => {
+    if (call < 3) throw upstreamError(503);
+
+    return 'recovered';
+  });
+
+  const output = await engineFor(provider, { maxRetries: 2 }).generate('hi');
+
+  assert.equal(output, 'recovered');
+  assert.equal(provider.calls, 3);
+});
+
+test('gives up after maxRetries and throws the normalized error', async () => {
+  const provider = fakeProvider(async () => {
+    throw upstreamError(429);
+  });
+
+  await assert.rejects(
+    () => engineFor(provider, { maxRetries: 2 }).generate('hi'),
+    (error: unknown) =>
+      error instanceof AIProviderError && error.code === 'rate_limit',
+  );
+  assert.equal(provider.calls, 3);
+});
+
+test('does not retry non-transient errors (401, 404)', async () => {
+  for (const status of [401, 404]) {
+    const provider = fakeProvider(async () => {
+      throw upstreamError(status);
+    });
+
+    await assert.rejects(() => engineFor(provider, { maxRetries: 2 }).generate('hi'));
+    assert.equal(provider.calls, 1, `status ${status} should not be retried`);
+  }
+});
+
+test('times out a provider that never responds, without retrying', async () => {
+  const provider = fakeProvider(() => new Promise<string>(() => {}));
+
+  await assert.rejects(
+    () => engineFor(provider, { timeoutMs: 20, maxRetries: 2 }).generate('hi'),
+    (error: unknown) => error instanceof AIProviderError && error.code === 'timeout',
+  );
+  assert.equal(provider.calls, 1);
+});
