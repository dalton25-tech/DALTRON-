diff --git a/apps/ai/core/errors.ts b/apps/ai/core/errors.ts
new file mode 100644
index 0000000..296fa2b
--- /dev/null
+++ b/apps/ai/core/errors.ts
@@ -0,0 +1,109 @@
+export type AIErrorCode =
+  | "config"
+  | "auth"
+  | "model_not_found"
+  | "rate_limit"
+  | "timeout"
+  | "unavailable"
+  | "bad_request"
+  | "unknown";
+
+// Only transient failures are retried. Timeouts are deliberately not retried so
+// a slow request that is still running upstream is not duplicated.
+const RETRYABLE_CODES: ReadonlySet<AIErrorCode> = new Set<AIErrorCode>([
+  "rate_limit",
+  "unavailable",
+]);
+
+export class AIProviderError extends Error {
+  readonly code: AIErrorCode;
+  readonly status: number | undefined;
+
+  constructor(
+    code: AIErrorCode,
+    message: string,
+    options: { status?: number; cause?: unknown } = {}
+  ) {
+    super(
+      message,
+      options.cause === undefined ? undefined : { cause: options.cause }
+    );
+
+    this.name = "AIProviderError";
+    this.code = code;
+    this.status = options.status;
+  }
+
+  get retryable(): boolean {
+    return RETRYABLE_CODES.has(this.code);
+  }
+}
+
+export function codeFromStatus(status: number): AIErrorCode {
+  if (status === 400) return "bad_request";
+  if (status === 401 || status === 403) return "auth";
+  if (status === 404) return "model_not_found";
+  if (status === 408 || status === 504) return "timeout";
+  if (status === 429) return "rate_limit";
+  if (status >= 500) return "unavailable";
+
+  return "unknown";
+}
+
+const NETWORK_ERROR_CODES = new Set([
+  "ECONNRESET",
+  "ECONNREFUSED",
+  "ENOTFOUND",
+  "ETIMEDOUT",
+  "EAI_AGAIN",
+]);
+
+function readStatus(error: unknown): number | undefined {
+  if (typeof error === "object" && error !== null && "status" in error) {
+    const status = (error as { status: unknown }).status;
+
+    if (typeof status === "number" && Number.isInteger(status)) {
+      return status;
+    }
+  }
+
+  return undefined;
+}
+
+function isNetworkError(error: unknown, depth = 0): boolean {
+  if (!(error instanceof Error) || depth > 2) return false;
+
+  const code = (error as { code?: unknown }).code;
+
+  if (typeof code === "string" && NETWORK_ERROR_CODES.has(code)) return true;
+  if (error.message.includes("fetch failed")) return true;
+
+  return isNetworkError(error.cause, depth + 1);
+}
+
+// Converts anything a provider throws into an AIProviderError. The message never
+// includes upstream response text; the original error is kept as `cause` for
+// server-side logging only.
+export function toProviderError(error: unknown): AIProviderError {
+  if (error instanceof AIProviderError) return error;
+
+  const status = readStatus(error);
+
+  if (status !== undefined) {
+    return new AIProviderError(
+      codeFromStatus(status),
+      `AI provider request failed with status ${status}.`,
+      { status, cause: error }
+    );
+  }
+
+  if (isNetworkError(error)) {
+    return new AIProviderError("unavailable", "Could not reach the AI provider.", {
+      cause: error,
+    });
+  }
+
+  return new AIProviderError("unknown", "AI provider request failed.", {
+    cause: error,
+  });
+}
