+import assert from 'node:assert/strict';
+import { afterEach, beforeEach, mock, test } from 'node:test';
+import { AIEngine } from '../core/engine.js';
+import { AIProviderError } from '../core/errors.js';
+import { fakeProvider, fastConfig, upstreamError } from './helpers.js';
+
+beforeEach(() => {
+  mock.method(console, 'log', () => {});
+});
+
+afterEach(() => {
+  mock.restoreAll();
+});
+
+test('AIEngine reports an unknown provider name as a config error', () => {
+  assert.throws(
+    () => new AIEngine({ ...fastConfig, providerName: 'does-not-exist' }),
+    (error: unknown) => error instanceof AIProviderError && error.code === 'config',
+  );
+});
+
+test('AIEngine reports an unknown model name as a config error', () => {
+  assert.throws(
+    () =>
+      new AIEngine(
+        { ...fastConfig, modelName: 'no-such-model' },
+        fakeProvider(async () => 'unused'),
+      ),
+    (error: unknown) => error instanceof AIProviderError && error.code === 'config',
+  );
+});
+
+test('AIEngine uses an injected provider and returns the response shape', async () => {
+  const engine = new AIEngine(fastConfig, fakeProvider(async (options) => `echo: ${options.input}`));
+
+  assert.deepEqual(await engine.run({ input: '  hello  ' }), {
+    output: 'echo: hello',
+    model: 'gemini-3.6-flash',
+    provider: 'fake',
+  });
+});
+
+test('AIEngine surfaces provider failures as AIProviderError', async () => {
+  const engine = new AIEngine(
+    fastConfig,
+    fakeProvider(async () => {
+      throw upstreamError(404);
+    }),
+  );
+
+  await assert.rejects(
+    () => engine.run({ input: 'hi' }),
+    (error: unknown) => error instanceof AIProviderError && error.code === 'model_not_found',
+  );
+});
