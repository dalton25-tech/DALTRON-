+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { after, afterEach, before, beforeEach, mock, test } from 'node:test';
+import { AIEngine } from '../core/engine.js';
+import { createApp } from '../src/app.js';
+import { setNexaEngine } from '../src/services/nexaService.js';
+import { fakeProvider, fastConfig, upstreamError } from './helpers.js';
+import type { FakeProvider } from './helpers.js';
+
+const ALLOWED_ORIGIN = 'http://localhost:5173';
+
+let server: Server;
+let baseUrl: string;
+
+before(async () => {
+  server = createApp({ allowedOrigins: [ALLOWED_ORIGIN] }).listen(0, '127.0.0.1');
+  await once(server, 'listening');
+
+  const { port } = server.address() as AddressInfo;
+
+  baseUrl = `http://127.0.0.1:${port}`;
+});
+
+after(
+  () =>
+    new Promise<void>((resolve) => {
+      server.closeAllConnections();
+      server.close(() => resolve());
+    }),
+);
+
+beforeEach(() => {
+  mock.method(console, 'log', () => {});
+  mock.method(console, 'warn', () => {});
+  mock.method(console, 'error', () => {});
+});
+
+afterEach(() => {
+  setNexaEngine(undefined);
+  mock.restoreAll();
+});
+
+function useProvider(provider: FakeProvider) {
+  setNexaEngine(new AIEngine(fastConfig, provider));
+}
+
+function postChat(body: string, headers: Record<string, string> = {}) {
+  return fetch(`${baseUrl}/api/nexa/chat`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...headers },
+    body,
+  });
+}
+
+test('GET /health reports the backend as online', async () => {
+  const response = await fetch(`${baseUrl}/health`);
+
+  assert.equal(response.status, 200);
+  assert.deepEqual(await response.json(), { status: 'online', system: 'Nexa Backend' });
+});
+
+test('POST /api/nexa/chat returns the AI output', async () => {
+  useProvider(fakeProvider(async (options) => `echo: ${options.input}`));
+
+  const response = await postChat(JSON.stringify({ message: 'Hello' }));
+
+  assert.equal(response.status, 200);
+  assert.deepEqual(await response.json(), {
+    output: 'echo: Hello',
+    model: 'gemini-3.6-flash',
+    provider: 'fake',
+  });
+});
+
+test('POST /api/nexa/chat rejects an empty message with 400', async () => {
+  const response = await postChat(JSON.stringify({ message: '  ' }));
+
+  assert.equal(response.status, 400);
+});
+
+test('POST /api/nexa/chat returns JSON 400 for a malformed body', async () => {
+  const response = await postChat('{not json');
+
+  assert.equal(response.status, 400);
+  assert.deepEqual(await response.json(), { error: 'Invalid request body.' });
+});
+
+test('POST /api/nexa/chat returns 413 for a body over the size limit', async () => {
+  const response = await postChat(JSON.stringify({ message: 'x'.repeat(20000) }));
+
+  assert.equal(response.status, 413);
+});
+
+test('POST /api/nexa/chat maps provider failures to HTTP errors', async () => {
+  useProvider(
+    fakeProvider(async () => {
+      throw upstreamError(429);
+    }),
+  );
+
+  const response = await postChat(JSON.stringify({ message: 'Hello' }));
+  const body = (await response.json()) as { code: string; error: string };
+
+  assert.equal(response.status, 429);
+  assert.equal(body.code, 'rate_limit');
+  assert.ok(!JSON.stringify(body).includes('upstream detail'));
+});
+
+test('CORS allows the configured origin and not others', async () => {
+  const allowed = await fetch(`${baseUrl}/health`, { headers: { Origin: ALLOWED_ORIGIN } });
+  const blocked = await fetch(`${baseUrl}/health`, { headers: { Origin: 'http://evil.example' } });
+
+  assert.equal(allowed.headers.get('access-control-allow-origin'), ALLOWED_ORIGIN);
+  assert.equal(blocked.headers.get('access-control-allow-origin'), null);
+});
