+import assert from 'node:assert/strict';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { after, test } from 'node:test';
+import { loadEnvFiles } from '../src/env.js';
+
+const KEYS = ['DALTRON_TEST_ROOT_ONLY', 'DALTRON_TEST_SHARED', 'DALTRON_TEST_OUTSIDE'];
+const tmp = mkdtempSync(path.join(tmpdir(), 'daltron-env-'));
+
+after(() => {
+  rmSync(tmp, { recursive: true, force: true });
+
+  for (const key of KEYS) delete process.env[key];
+});
+
+test('loadEnvFiles finds the repo-root .env from a workspace directory', () => {
+  const repo = path.join(tmp, 'repo');
+  const workspace = path.join(repo, 'apps', 'ai');
+
+  mkdirSync(workspace, { recursive: true });
+  writeFileSync(path.join(tmp, '.env'), 'DALTRON_TEST_OUTSIDE=outside\n');
+  writeFileSync(path.join(repo, 'package.json'), JSON.stringify({ workspaces: ['apps/*'] }));
+  writeFileSync(path.join(repo, '.env'), 'DALTRON_TEST_ROOT_ONLY=1\nDALTRON_TEST_SHARED=root\n');
+  writeFileSync(path.join(workspace, '.env'), 'DALTRON_TEST_SHARED=workspace\n');
+
+  const loaded = loadEnvFiles(workspace);
+
+  assert.deepEqual(loaded, [path.join(workspace, '.env'), path.join(repo, '.env')]);
+  assert.equal(process.env.DALTRON_TEST_ROOT_ONLY, '1');
+  // The nearer file wins over the repo-root file.
+  assert.equal(process.env.DALTRON_TEST_SHARED, 'workspace');
+  // Directories above the repo root are never read.
+  assert.equal(process.env.DALTRON_TEST_OUTSIDE, undefined);
+});
