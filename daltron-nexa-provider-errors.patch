@@ -0,0 +1,45 @@
+import { existsSync, readFileSync } from 'node:fs';
+import path from 'node:path';
+
+function isRepoRoot(dir: string): boolean {
+  if (existsSync(path.join(dir, '.git'))) return true;
+
+  try {
+    const pkg = JSON.parse(readFileSync(path.join(dir, 'package.json'), 'utf8')) as {
+      workspaces?: unknown;
+    };
+
+    return pkg.workspaces !== undefined;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Loads `.env` files starting at `startDir` and walking up to the repository
+ * root (a directory with `.git` or a workspaces `package.json`). `npm --workspace`
+ * runs scripts from `apps/ai`, so the repo-root `.env` must be found from there.
+ * Values already present in `process.env` (including ones set by a nearer file) win.
+ * Returns the files that were loaded.
+ */
+export function loadEnvFiles(startDir: string = process.cwd()): string[] {
+  const loaded: string[] = [];
+  let dir = path.resolve(startDir);
+
+  for (;;) {
+    const file = path.join(dir, '.env');
+
+    if (existsSync(file)) {
+      process.loadEnvFile(file);
+      loaded.push(file);
+    }
+
+    const parent = path.dirname(dir);
+
+    if (isRepoRoot(dir) || parent === dir) break;
+
+    dir = parent;
+  }
+
+  return loaded;
+}
