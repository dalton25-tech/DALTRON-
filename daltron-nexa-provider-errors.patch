+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// Rejects with a "timeout" error if `run` takes longer than `timeoutMs`.
+// Note: this stops waiting; it cannot cancel the underlying provider request.
+function withTimeout<T>(run: () => Promise<T>, timeoutMs: number): Promise<T> {
+  if (!(timeoutMs > 0)) return Promise.resolve().then(run);
+
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(() => {
+      reject(
+        new AIProviderError(
+          "timeout",
+          `AI provider did not respond within ${timeoutMs} ms.`
+        )
+      );
+    }, timeoutMs);
+
+    Promise.resolve()
+      .then(run)
+      .then(
+        (value) => {
+          clearTimeout(timer);
+          resolve(value);
+        },
+        (error: unknown) => {
+          clearTimeout(timer);
+          reject(error);
+        }
+      );
+  });
+}
