+++ b/apps/ai/tests/errors.test.ts
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { AIProviderError, toProviderError } from '../core/errors.js';
+import type { AIErrorCode } from '../core/errors.js';
+import { upstreamError } from './helpers.js';
+
+const statusCases: Array<[number, AIErrorCode, boolean]> = [
+  [400, 'bad_request', false],
+  [401, 'auth', false],
+  [403, 'auth', false],
+  [404, 'model_not_found', false],
+  [408, 'timeout', false],
+  [429, 'rate_limit', true],
+  [500, 'unavailable', true],
+  [503, 'unavailable', true],
+  [504, 'timeout', false],
+  [418, 'unknown', false],
+];
+
+for (const [status, code, retryable] of statusCases) {
+  test(`toProviderError maps status ${status} to ${code} (retryable: ${retryable})`, () => {
+    const error = toProviderError(upstreamError(status));
+
+    assert.equal(error.code, code);
+    assert.equal(error.status, status);
+    assert.equal(error.retryable, retryable);
+  });
+}
+
+test('toProviderError keeps upstream text out of the message but preserves the cause', () => {
+  const original = upstreamError(404, 'secret upstream detail');
+  const error = toProviderError(original);
+
+  assert.ok(!error.message.includes('secret upstream detail'));
+  assert.equal(error.cause, original);
+});
+
+test('toProviderError treats network failures as retryable "unavailable"', () => {
+  const reset = Object.assign(new Error('socket hang up'), { code: 'ECONNRESET' });
+  const fetchFailed = new TypeError('fetch failed');
+
+  assert.equal(toProviderError(reset).code, 'unavailable');
+  assert.equal(toProviderError(fetchFailed).code, 'unavailable');
+  assert.equal(toProviderError(fetchFailed).retryable, true);
+});
+
+test('toProviderError returns existing AIProviderError instances unchanged', () => {
+  const original = new AIProviderError('config', 'not configured');
+
+  assert.equal(toProviderError(original), original);
+});
+
+test('toProviderError wraps unknown errors and non-Error values as "unknown"', () => {
+  assert.equal(toProviderError(new Error('boom')).code, 'unknown');
+  assert.equal(toProviderError('a string').code, 'unknown');
+  assert.equal(toProviderError(undefined).retryable, false);
+});
diff --git a/apps/ai/tests/helpers.ts b/apps/ai/tests/helpers.ts
new file mode 100644
index 0000000..415f6ee
--- /dev/null
+++ b/apps/ai/tests/helpers.ts
@@ -0,0 +1,36 @@
+import type { AIConfig } from '../core/config/config.js';
+import type { GenerateOptions, ModelProvider } from '../core/models/providers/providers.js';
+
+// Fast, deterministic settings for tests: no retries unless a test opts in.
+export const fastConfig: AIConfig = {
+  modelName: 'gemini-3.6-flash',
+  providerName: 'fake',
+  temperature: 0,
+  maxTokens: 10,
+  timeoutMs: 1000,
+  maxRetries: 0,
+  retryBaseDelayMs: 1,
+};
+
+export type FakeProvider = ModelProvider & { calls: number };
+
+export function fakeProvider(
+  handler: (options: GenerateOptions, call: number) => Promise<string>,
+): FakeProvider {
+  const provider: FakeProvider = {
+    name: 'Fake',
+    calls: 0,
+    generate(options) {
+      provider.calls += 1;
+
+      return handler(options, provider.calls);
+    },
+  };
+
+  return provider;
+}
+
+// An error shaped like the ones the Gemini SDK throws (it carries a numeric status).
+export function upstreamError(status: number, message = 'upstream detail'): Error {
+  return Object.assign(new Error(message), { status });
+}
