@@ -0,0 +1,135 @@
+import assert from 'node:assert/strict';
+import { afterEach, beforeEach, mock, test } from 'node:test';
+import type { Request, Response } from 'express';
+import { AIEngine } from '../core/engine.js';
+import { AIProviderError } from '../core/errors.js';
+import { chatWithNexa, MAX_MESSAGE_LENGTH } from '../src/controllers/nexaController.js';
+import { setNexaEngine } from '../src/services/nexaService.js';
+import { fakeProvider, fastConfig, upstreamError } from './helpers.js';
+import type { FakeProvider } from './helpers.js';
+
+interface Captured {
+  statusCode: number;
+  body: unknown;
+}
+
+// A minimal stand-in for an Express response that records what was sent.
+async function callChat(body: unknown): Promise<Captured> {
+  const captured: Captured = { statusCode: 200, body: undefined };
+  const res = {
+    status(code: number) {
+      captured.statusCode = code;
+
+      return res;
+    },
+    json(payload: unknown) {
+      captured.body = payload;
+
+      return res;
+    },
+  };
+
+  await chatWithNexa({ body } as unknown as Request, res as unknown as Response);
+
+  return captured;
+}
+
+function useProvider(provider: FakeProvider, overrides: Partial<typeof fastConfig> = {}) {
+  setNexaEngine(new AIEngine({ ...fastConfig, ...overrides }, provider));
+}
+
+beforeEach(() => {
+  mock.method(console, 'log', () => {});
+  mock.method(console, 'warn', () => {});
+  mock.method(console, 'error', () => {});
+});
+
+afterEach(() => {
+  setNexaEngine(undefined);
+  mock.restoreAll();
+});
+
+test('returns 200 with output, model and provider on success', async () => {
+  useProvider(fakeProvider(async () => 'Hi there'));
+
+  const result = await callChat({ message: 'Hello' });
+
+  assert.equal(result.statusCode, 200);
+  assert.deepEqual(result.body, {
+    output: 'Hi there',
+    model: 'gemini-3.6-flash',
+    provider: 'fake',
+  });
+});
+
+test('rejects missing, empty and non-string messages with 400', async () => {
+  for (const body of [undefined, {}, { message: '   ' }, { message: 42 }]) {
+    const result = await callChat(body);
+
+    assert.equal(result.statusCode, 400, JSON.stringify(body));
+  }
+});
+
+test('rejects over-long messages with 413', async () => {
+  const result = await callChat({ message: 'x'.repeat(MAX_MESSAGE_LENGTH + 1) });
+
+  assert.equal(result.statusCode, 413);
+});
+
+const failureCases: Array<[string, () => Promise<string>, number, string]> = [
+  ['rate limit', async () => { throw upstreamError(429); }, 429, 'rate_limit'],
+  ['unavailable', async () => { throw upstreamError(503); }, 503, 'unavailable'],
+  ['model not found', async () => { throw upstreamError(404); }, 502, 'model_not_found'],
+  ['auth failure', async () => { throw upstreamError(401); }, 502, 'auth'],
+  ['provider config error', async () => { throw new AIProviderError('config', 'no key'); }, 503, 'config'],
+  ['unclassified failure', async () => { throw new Error('boom'); }, 502, 'unknown'],
+];
+
+for (const [name, handler, expectedStatus, expectedCode] of failureCases) {
+  test(`maps a provider ${name} to HTTP ${expectedStatus} (${expectedCode}) without leaking upstream text`, async () => {
+    useProvider(fakeProvider(handler));
+
+    const result = await callChat({ message: 'Hello' });
+
+    assert.equal(result.statusCode, expectedStatus);
+    assert.equal((result.body as { code?: string }).code, expectedCode);
+    assert.ok(!JSON.stringify(result.body).includes('upstream detail'));
+  });
+}
+
+test('maps a provider timeout to HTTP 504', async () => {
+  useProvider(fakeProvider(() => new Promise<string>(() => {})), { timeoutMs: 20 });
+
+  const result = await callChat({ message: 'Hello' });
+
+  assert.equal(result.statusCode, 504);
+  assert.equal((result.body as { code?: string }).code, 'timeout');
+});
+
+test('retries a transient failure and still returns 200', async () => {
+  const provider = fakeProvider(async (_options, call) => {
+    if (call === 1) throw upstreamError(503);
+
+    return 'second try';
+  });
+
+  useProvider(provider, { maxRetries: 2 });
+
+  const result = await callChat({ message: 'Hello' });
+
+  assert.equal(result.statusCode, 200);
+  assert.equal(provider.calls, 2);
+});
+
+test('returns a generic 500 for errors that are not provider errors', async () => {
+  setNexaEngine({
+    run: async () => {
+      throw new Error('internal detail');
+    },
+  } as unknown as AIEngine);
+
+  const result = await callChat({ message: 'Hello' });
+
+  assert.equal(result.statusCode, 500);
+  assert.ok(!JSON.stringify(result.body).includes('internal detail'));
+});
